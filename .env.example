# ─── App ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Your deployed Render URL (used for OAuth callback URLs)
BASE_URL=http://localhost:3001

# Frontend URL (Vite in dev, same as BASE_URL in production)
CLIENT_URL=http://localhost:5173

# ─── Secrets ───────────────────────────────────────────────────
# Use a long random string in production — never share this
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Database (REQUIRED for persistent accounts on Render) ─────
# Get a free URI from https://cloud.mongodb.com (see MONGODB_SETUP.md)
# Without this, accounts are lost every time Render restarts
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/studymate?retryWrites=true&w=majority

# ─── AI ────────────────────────────────────────────────────────
# Get free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google OAuth (optional) ───────────────────────────────────
# Setup: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Callback URL: https://YOUR_RENDER_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth (optional) ───────────────────────────────────
# Setup: https://github.com/settings/developers → New OAuth App
# Callback URL: https://YOUR_RENDER_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Discord OAuth (optional) ──────────────────────────────────
# Setup: https://discord.com/developers/applications → OAuth2
# Callback URL: https://YOUR_RENDER_URL/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
